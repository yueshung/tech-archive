---
import { NAV, SITE } from '../data/site';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const full = withBase(href);
  return href === '/' ? path === full : path.startsWith(full);
};
---
<header class="border-b border-ink bg-paper sticky top-0 z-40" data-pagefind-ignore>
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-6">
    <a href={withBase('/')} class="flex items-baseline gap-2 no-underline">
      <span class="display text-xl font-semibold tracking-tight">TECH ARCHIVE</span>
      <span class="eyebrow hidden sm:inline">/ {SITE.owner}</span>
    </a>
    <nav aria-label="主要導覽" class="hidden lg:flex items-center gap-6 text-sm">
      {NAV.map((n) => (
        <a href={withBase(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}
           class:list={['py-1 border-b-2 transition-colors no-underline', isCurrent(n.href) ? 'border-accent text-ink' : 'border-transparent text-ink-2 hover:text-accent']}>
          {n.label}
        </a>
      ))}
      <a href={withBase('/search/')} class="btn !py-1 !px-3 !text-xs" aria-label="搜尋">Search ⌕</a>
    </nav>
    <button id="menu-toggle" type="button" class="lg:hidden btn !py-1 !px-3 !text-xs" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav id="mobile-nav" aria-label="行動版導覽" class="hidden lg:hidden border-t border-line bg-paper">
    <ul class="mx-auto max-w-6xl px-5 py-3 grid grid-cols-2 gap-x-6">
      {[...NAV, { href: '/search/', label: 'Search' }].map((n) => (
        <li><a href={withBase(n.href)} class="block py-2 text-sm no-underline hover:text-accent" aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
