---
import type { Source } from '../utils/content';
import { fmtDate } from '../utils/url';
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
{sources.length > 0 && (
  <section aria-labelledby="sources-h" data-pagefind-ignore>
    <h2 id="sources-h" class="eyebrow mb-3">Sources</h2>
    <ol class="list-decimal pl-5 space-y-2 text-sm text-ink-2">
      {sources.map((s) => (
        <li>
          <a href={s.url} rel="noopener" class="text-accent underline underline-offset-2">{s.title}</a>
          <span class="text-mute">
            {s.organization ? ` · ${s.organization}` : ''}{s.author ? ` · ${s.author}` : ''}{s.publishedAt ? ` · 發布 ${fmtDate(s.publishedAt)}` : ''}{s.accessedAt ? ` · 查閱 ${fmtDate(s.accessedAt)}` : ''}
          </span>
        </li>
      ))}
    </ol>
  </section>
)}
