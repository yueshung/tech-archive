---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  <nav class="toc" aria-label="文章目錄" data-pagefind-ignore>
    <p class="eyebrow mb-3">On this page</p>
    {items.map((h) => <a href={`#${h.slug}`} class={`depth-${h.depth}`}>{h.text}</a>)}
  </nav>
)}
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            map.get(e.target.id)?.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>
