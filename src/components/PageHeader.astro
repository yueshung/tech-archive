---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="mx-auto max-w-6xl px-5 pt-16 pb-10">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="display text-4xl sm:text-5xl font-semibold mt-3 max-w-3xl">{title}</h1>
  {lead && <p class="text-ink-2 text-lg mt-5 max-w-2xl">{lead}</p>}
</section>
