---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getItems, allTags } from '../../utils/content';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const items = await getItems();
  return allTags(items).map(([tag]) => ({
    params: { tag },
    props: { tag, list: items.filter((i) => i.tags.includes(tag)) },
  }));
}
const { tag, list } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`標籤 ${tag} 下的內容`}>
  <PageHeader eyebrow="Tag" title={`#${tag}`} lead={`${list.length} 筆已發布內容`} />
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-x-10 md:grid-cols-2">{list.map((i) => <ArticleCard item={i} showKind />)}</div>
    <p class="mt-10"><a href={withBase('/tags/')} class="btn">← 所有標籤</a></p>
  </div>
</BaseLayout>
