---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getItems, allTags, allCategories, uniqueSources, countBy, KIND_LABEL } from '../utils/content';
import { SITE } from '../data/site';
import { withBase, fmtDate } from '../utils/url';

const all = await getItems();
const projects = all.filter((i) => i.kind === 'projects');
const knowledge = all.filter((i) => i.kind === 'knowledge');
const notes = all.filter((i) => i.kind === 'notes');
const featured = projects.filter((p) => (p.entry.data as any).featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, 4);
const recent = all.slice(0, 6);
const techs = countBy(projects.flatMap((p) => (p.entry.data as any).techStack as string[])).slice(0, 12);
const stats = [
  ['Projects', projects.length],
  ['Knowledge', knowledge.length],
  ['Notes', notes.length],
  ['Categories', allCategories(all).length],
  ['Tags', allTags(all).length],
  ['Sources', uniqueSources(all).length],
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-20 pb-16 grid gap-12 lg:grid-cols-[1.4fr_1fr] items-end">
    <div>
      <p class="eyebrow">Developer Portfolio · Technical Archive</p>
      <h1 class="display text-5xl sm:text-7xl font-semibold mt-5">
        作品先行，<br />知識<span class="text-accent">可追溯</span>。
      </h1>
      <p class="text-lg text-ink-2 mt-7 max-w-xl">
        TECH ARCHIVE 是 <a href={SITE.githubProfile} rel="noopener" class="text-accent underline underline-offset-4">@{SITE.owner}</a> 的作品集與技術知識庫。
        以 GitHub 公開專案為主軸，再用官方文件與可靠資料補上背後的技術原理。
      </p>
      <div class="flex flex-wrap gap-3 mt-9">
        <a href={withBase('/projects/')} class="btn btn-solid">瀏覽 Projects →</a>
        <a href={withBase('/graph/')} class="btn">Knowledge Graph</a>
        <a href={withBase('/search/')} class="btn">Search ⌕</a>
      </div>
    </div>
    <dl class="grid grid-cols-3 border-t border-ink" aria-label="內容統計">
      {stats.map(([k, v]) => (
        <div class="py-5 pr-3 border-b border-line">
          <dd class="display text-4xl font-semibold">{v}</dd>
          <dt class="eyebrow mt-1 !text-mute">{k}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- Featured Projects -->
  <section class="mx-auto max-w-6xl px-5 py-12" aria-labelledby="featured-h">
    <div class="flex items-end justify-between gap-4 mb-2">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="featured-h" class="display text-3xl sm:text-4xl font-semibold mt-2">精選 Projects</h2>
      </div>
      <a href={withBase('/projects/')} class="text-sm underline underline-offset-4 hover:text-accent">全部作品 →</a>
    </div>
    {shown.length === 0
      ? <p class="py-12 text-mute">尚未有已發布作品。</p>
      : (
        <div class="grid gap-x-10 md:grid-cols-2 mt-4">
          {shown.map((p, i) => <ProjectCard item={p} large={i === 0} />)}
        </div>
      )}
  </section>

  <!-- Recent + Tech domains -->
  <section class="mx-auto max-w-6xl px-5 py-12 grid gap-14 lg:grid-cols-[1.4fr_1fr]">
    <div aria-labelledby="recent-h">
      <p class="eyebrow">Recently updated</p>
      <h2 id="recent-h" class="display text-3xl font-semibold mt-2 mb-4">最近更新</h2>
      <ul class="border-t border-ink">
        {recent.map((i) => (
          <li class="border-b border-line">
            <a href={i.url} class="grid grid-cols-[5.5rem_1fr_auto] gap-4 items-baseline py-3 no-underline hover:text-accent">
              <span class="eyebrow">{KIND_LABEL[i.kind]}</span>
              <span class="font-serif text-lg leading-snug">{i.title}</span>
              <span class="font-mono text-xs text-mute">{fmtDate(i.updatedAt)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div aria-labelledby="tech-h">
      <p class="eyebrow">Technical range</p>
      <h2 id="tech-h" class="display text-3xl font-semibold mt-2 mb-4">專案技術領域</h2>
      <p class="text-sm text-mute mb-4">統計自已發布作品的 techStack 欄位。</p>
      <div class="flex flex-wrap gap-2">
        {techs.map(([t, n]) => <a class="chip" href={`${withBase('/projects/')}?tech=${encodeURIComponent(t)}`}>{t} <span class="text-mute">{n}</span></a>)}
      </div>
    </div>
  </section>

  <!-- Knowledge & Notes -->
  <section class="mx-auto max-w-6xl px-5 py-12 grid gap-14 md:grid-cols-2">
    <div>
      <div class="flex items-baseline justify-between"><h2 class="display text-2xl font-semibold">最新 Knowledge</h2><a href={withBase('/knowledge/')} class="text-sm underline underline-offset-4 hover:text-accent">全部 →</a></div>
      <div class="mt-3">{knowledge.slice(0, 3).map((i) => <ArticleCard item={i} />)}</div>
    </div>
    <div>
      <div class="flex items-baseline justify-between"><h2 class="display text-2xl font-semibold">最新 Notes</h2><a href={withBase('/notes/')} class="text-sm underline underline-offset-4 hover:text-accent">全部 →</a></div>
      <div class="mt-3">{notes.slice(0, 3).map((i) => <ArticleCard item={i} />)}</div>
    </div>
  </section>
</BaseLayout>
