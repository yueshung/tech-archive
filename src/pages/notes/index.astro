---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ListFilter from '../../components/ListFilter.astro';
import { getItems, allCategories, allTags } from '../../utils/content';

const items = await getItems('notes');
const cats = allCategories(items);
const tags = allTags(items);
---
<BaseLayout title="Notes" description="與作品相關的閱讀、實驗與除錯紀錄。個人經驗只在使用者確認後才會寫成親身經歷。">
  <PageHeader eyebrow="Notes" title="開發與學習筆記" lead="與作品相關的閱讀、實驗與除錯紀錄。個人經驗只在使用者確認後才會寫成親身經歷。" />
  <div class="mx-auto max-w-6xl px-5" data-filter-root>
    <div class="grid gap-4 border-y border-line py-5">
      <label class="block">
        <span class="eyebrow">搜尋列表</span>
        <input data-filter-q type="search" class="field mt-1" placeholder="標題、描述、標籤…" />
      </label>
      {cats.length > 0 && (
        <div class="flex flex-wrap items-center gap-2"><span class="eyebrow mr-2">分類</span>
          {cats.map(([c, n]) => <button type="button" class="chip" data-group="category" data-value={c} aria-pressed="false">{c} <span class="text-mute">{n}</span></button>)}
        </div>
      )}
      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2"><span class="eyebrow mr-2">標籤</span>
          {tags.map(([t, n]) => <button type="button" class="chip" data-group="tags" data-value={t} aria-pressed="false">#{t} <span class="text-mute">{n}</span></button>)}
        </div>
      )}
      <div class="flex items-center justify-between text-sm text-mute">
        <p aria-live="polite">顯示 <span data-count>{items.length}</span> / {items.length} 篇</p>
        <button type="button" class="chip" data-reset hidden>清除篩選</button>
      </div>
    </div>
    {items.length === 0 && <p class="py-16 text-mute">目前沒有已發布的內容。請在 <code>src/content/notes/</code> 新增 Markdown 並將 <code>status</code> 設為 <code>published</code>。</p>}
    <div class="grid gap-x-10 md:grid-cols-2 mt-6">
      {items.map((i) => <ArticleCard item={i} />)}
    </div>
    <p data-empty hidden class="py-16 text-mute">沒有符合條件的內容，請調整搜尋或清除篩選。</p>
  </div>
  <ListFilter />
</BaseLayout>
