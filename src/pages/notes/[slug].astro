---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import { getItems } from '../../utils/content';

export async function getStaticPaths() {
  const items = await getItems('notes');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item.entry);
const all = await getItems();
---
<BaseLayout title={item.title} description={item.description}>
  <ContentPage item={item} headings={headings} all={all}>
    <Content />
  </ContentPage>
</BaseLayout>
