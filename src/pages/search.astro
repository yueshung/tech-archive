---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { withBase } from '../utils/url';
---
<BaseLayout title="Search" description="全站全文搜尋（Pagefind）。只搜尋已發布內容。">
  <PageHeader eyebrow="Search" title="全文搜尋" lead="由 Pagefind 在建置後產生靜態索引；草稿、review 與封存內容不會被索引。" />
  <div class="mx-auto max-w-3xl px-5" id="search-root" data-base={withBase('/')}>
    <label class="block">
      <span class="eyebrow">關鍵字</span>
      <input id="search-q" type="search" class="field mt-1 text-lg" placeholder="例如：Flutter、content collections、時間線…" autocomplete="off" />
    </label>
    <p id="search-status" class="text-sm text-mute mt-4" aria-live="polite">輸入關鍵字開始搜尋。</p>
    <ol id="search-results" class="mt-4 divide-y divide-line border-y border-line empty:hidden"></ol>
  </div>
  <script>
    const root = document.getElementById('search-root')!;
    const input = document.getElementById('search-q') as HTMLInputElement;
    const status = document.getElementById('search-status')!;
    const list = document.getElementById('search-results')!;
    const base = root.dataset.base || '/';
    let pf: any = undefined;

    async function load() {
      if (pf !== undefined) return pf;
      try {
        pf = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
        await pf.init?.();
      } catch {
        pf = null;
      }
      return pf;
    }
    const fix = (u: string) => (base !== '/' && !u.startsWith(base) ? base.replace(/\/$/, '') + u : u);
    let timer: number | undefined;

    async function run() {
      const q = input.value.trim();
      list.innerHTML = '';
      if (!q) { status.textContent = '輸入關鍵字開始搜尋。'; return; }
      const engine = await load();
      if (!engine) { status.textContent = '找不到搜尋索引。Pagefind 只在建置後產生：請執行 npm run build 後用 npm run preview 開啟。'; return; }
      status.textContent = '搜尋中…';
      const res = await engine.search(q);
      const top = await Promise.all(res.results.slice(0, 20).map((r: any) => r.data()));
      if (top.length === 0) { status.textContent = `沒有找到「${q}」的結果。試試較短的關鍵字或英文名詞。`; return; }
      status.textContent = `找到 ${res.results.length} 筆結果${res.results.length > 20 ? '（顯示前 20 筆）' : ''}。`;
      for (const d of top) {
        const li = document.createElement('li');
        li.className = 'py-4';
        const a = document.createElement('a');
        a.href = fix(d.url);
        a.className = 'font-serif text-xl no-underline hover:text-accent';
        a.textContent = d.meta?.title || d.url;
        const kind = document.createElement('span');
        kind.className = 'eyebrow ml-3';
        kind.textContent = d.meta?.kind || '';
        const p = document.createElement('p');
        p.className = 'text-sm text-ink-2 mt-1';
        p.innerHTML = d.excerpt; // 內容來自本站自己的索引，excerpt 只含 <mark>
        li.append(a, kind, p);
        list.appendChild(li);
      }
    }
    input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 200); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { input.value = initial; run(); }
  </script>
</BaseLayout>
